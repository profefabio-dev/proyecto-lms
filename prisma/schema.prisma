generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMINISTRADOR
  TUTOR
  ESTUDIANTE
  SUPERADMIN
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum EstadoCurso {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

enum TipoContenido {
  VIDEO
  TEXTO
  DOCUMENTO
}

// US30: estado de una sección, fijado a mano por el Tutor (mismo patrón que
// Contents.visible en US12) — no se calcula por fecha, porque no todos los
// cursos siguen un calendario semanal real.
enum EstadoSeccion {
  DISPONIBLE
  NO_DISPONIBLE
}

model Users {
  id        String        @id @default(uuid())
  authId    String?       @unique
  nombre    String
  apellido  String
  email     String        @unique
  rol       Rol
  estado    EstadoUsuario @default(ACTIVO)
  // Épica Multi-docente (Backlog.md): obligatorio a nivel de aplicación
  // solo para ADMINISTRADOR y TUTOR (cada uno pertenece a un único
  // espacio, sin acceso a los datos de otro). SUPERADMIN y ESTUDIANTE no
  // tienen espacioId — SUPERADMIN opera sobre todos los espacios (para
  // crearlos/listarlos/desactivarlos, nunca para leer sus datos
  // internos); un ESTUDIANTE es una cuenta única y compartida entre
  // espacios, decisión tomada el 02/09/2026 para no obligarlo a crear una
  // cuenta nueva por cada docente — su relación con un espacio queda dada
  // por sus inscripciones (`CourseUsers`) a cursos de Tutores de ese
  // espacio, no por este campo. Ver Diagrama_de_Arquitectura.md.
  espacioId String?
  createdAt DateTime      @default(now())

  espacio          Espacios?      @relation(fields: [espacioId], references: [id])
  cursosComoTutor  Courses[]      @relation("TutorCourses")
  inscripciones    CourseUsers[]
  contenidosVistos ContentViews[]

  @@map("users")
}

// Épica Multi-docente (Backlog.md, Sprint 7): un espacio = un docente o
// institución. Administradores y Tutores pertenecen a exactamente un
// espacio (Users.espacioId); los cursos lo heredan de su Tutor. Ver
// Diagrama_de_Arquitectura.md, sección "Cambios previstos".
model Espacios {
  id        String        @id @default(uuid())
  nombre    String
  estado    EstadoUsuario @default(ACTIVO)
  createdAt DateTime      @default(now())

  usuarios Users[]

  @@map("espacios")
}

model Courses {
  id          String      @id @default(uuid())
  titulo      String
  descripcion String
  imagen      String?
  tutorId     String
  estado      EstadoCurso @default(BORRADOR)
  createdAt   DateTime    @default(now())

  tutor      Users         @relation("TutorCourses", fields: [tutorId], references: [id])
  inscritos  CourseUsers[]
  contenidos Contents[]
  secciones  Secciones[]

  @@map("courses")
}

// US30: agrupa el contenido de un curso en secciones plegables con estado
// (Disponible/No disponible) y una marca opcional de "semana actual", según
// lo acordado con el docente (08/09/2026):
// - Entidad nueva en vez de reutilizar campos existentes, para no forzar un
//   concepto de "semana" sobre cursos que no lo necesitan.
// - `estado` lo fija el Tutor a mano (mismo patrón que Contents.visible en
//   US12), no se calcula por fecha.
// - `esActual` es exclusiva por curso (una sola sección "semana actual" a la
//   vez) — la exclusividad se aplica en `lib/actions/mark-current-section.ts`,
//   no con una restricción de base de datos, porque Postgres no tiene una
//   forma simple de expresar "a lo sumo una fila en TRUE por courseId" sin un
//   índice parcial adicional que no aporta valor para este volumen de datos.
// - El contenido de los cursos ya existentes queda sin sección
//   (`Contents.seccionId` es opcional) y sigue viéndose igual que hoy: lista
//   plana, siempre visible, sin agrupar.
model Secciones {
  id        String        @id @default(uuid())
  courseId  String
  titulo    String
  orden     Int           @default(0)
  estado    EstadoSeccion @default(DISPONIBLE)
  esActual  Boolean       @default(false)
  createdAt DateTime      @default(now())

  course     Courses    @relation(fields: [courseId], references: [id])
  contenidos Contents[]

  @@map("secciones")
}

model CourseUsers {
  id       String   @id @default(uuid())
  courseId String
  userId   String
  fecha    DateTime @default(now())

  course Courses @relation(fields: [courseId], references: [id])
  user   Users   @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
  @@map("course_users")
}

model Contents {
  id          String        @id @default(uuid())
  courseId    String
  titulo      String
  descripcion String?
  tipo        TipoContenido
  contenido   String
  orden       Int           @default(0)
  visible     Boolean       @default(true)
  // US30: sección a la que pertenece este contenido, opcional (ver
  // `Secciones` arriba) — sin sección asignada, el contenido se comporta
  // exactamente igual que antes de US30 (lista plana, siempre visible).
  seccionId   String?

  course     Courses        @relation(fields: [courseId], references: [id])
  seccion    Secciones?     @relation(fields: [seccionId], references: [id])
  documentos Documents[]
  vistos     ContentViews[]

  @@map("contents")
}

model Documents {
  id        String @id @default(uuid())
  contentId String
  archivo   String
  nombre    String
  tipo      String

  content Contents @relation(fields: [contentId], references: [id])

  @@map("documents")
}

// US19: registra que un Estudiante vio un contenido, para calcular el
// porcentaje de avance por curso en su dashboard. Se marca cuando el
// Estudiante hace clic en "Marcar como visto" sobre ese contenido — ver
// `lib/actions/mark-content-viewed.ts` (rediseñado el 2026-08-31; el
// diseño original la marcaba automáticamente al abrir la página, pero
// eso no distinguía "abrió la página" de "consumió el contenido").
// La restricción única evita duplicados si se marca más de una vez, y
// conserva la fecha de la primera vez que se vio.
model ContentViews {
  id        String   @id @default(uuid())
  contentId String
  userId    String
  vistoEn   DateTime @default(now())

  content Contents @relation(fields: [contentId], references: [id])
  user    Users    @relation(fields: [userId], references: [id])

  @@unique([contentId, userId])
  @@map("content_views")
}
