generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMINISTRADOR
  TUTOR
  ESTUDIANTE
  SUPERADMIN
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum EstadoCurso {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

enum TipoContenido {
  VIDEO
  TEXTO
  DOCUMENTO
  // US45 (20/11/2026): dos tipos más, pedidos al ver que un curso con todos
  // los recursos de la plataforma seguía viéndose igual que cualquier otro
  // — con tres tipos, todos los cursos se parecen.
  // ENLACE: un recurso externo (una simulación, un artículo, una
  // herramienta en línea) que antes había que pegar dentro de un TEXTO
  // como un link suelto, sin ficha ni aviso de que sale del sitio.
  // CODIGO: un fragmento de código con su lenguaje, para las clases de
  // programación — en un TEXTO en Markdown perdía el formato y se mezclaba
  // con la explicación.
  ENLACE
  CODIGO
}

// US30: estado de una sección, fijado a mano por el Tutor (mismo patrón que
// Contents.visible en US12) — no se calcula por fecha, porque no todos los
// cursos siguen un calendario semanal real.
enum EstadoSeccion {
  DISPONIBLE
  NO_DISPONIBLE
}

// US44 (20/11/2026): una ruta de aprendizaje empieza en BORRADOR —
// invisible para los estudiantes mientras el Tutor le agrega cursos— y se
// PUBLICADA cuando ya se puede recorrer. Mismo patrón que `EstadoCurso`,
// pero con dos estados: una ruta no se archiva, se despublica.
enum EstadoRuta {
  BORRADOR
  PUBLICADA
}

model Users {
  id        String        @id @default(uuid())
  authId    String?       @unique
  nombre    String
  apellido  String
  email     String        @unique
  rol       Rol
  estado    EstadoUsuario @default(ACTIVO)
  // US29 (carga masiva), 16/09/2026: grado/grupo detectado en la hoja
  // de origen del Excel al crear el estudiante (ej. "6A") — antes se
  // extraía solo para mostrarlo en la vista previa y para inscripción,
  // sin guardarse (decisión explícita del 15/09/2026). Se revirtió esa
  // decisión a pedido del docente para poder distinguir visualmente a
  // los estudiantes por grado en la lista de "Asignar estudiantes" (ver
  // `lib/group-color.ts`). Opcional: un estudiante creado a mano (US06)
  // o desde un archivo sin columna de grado no tiene ningún valor aquí.
  grado     String?
  // Épica Multi-docente (Backlog.md): obligatorio a nivel de aplicación
  // solo para ADMINISTRADOR y TUTOR (cada uno pertenece a un único
  // espacio, sin acceso a los datos de otro). SUPERADMIN y ESTUDIANTE no
  // tienen espacioId — SUPERADMIN opera sobre todos los espacios (para
  // crearlos/listarlos/desactivarlos, nunca para leer sus datos
  // internos); un ESTUDIANTE es una cuenta única y compartida entre
  // espacios, decisión tomada el 02/09/2026 para no obligarlo a crear una
  // cuenta nueva por cada docente — su relación con un espacio queda dada
  // por sus inscripciones (`CourseUsers`) a cursos de Tutores de ese
  // espacio, no por este campo. Ver Diagrama_de_Arquitectura.md.
  espacioId String?
  // US50 (25/11/2026): en qué espacio se creó esta cuenta. Solo para
  // ESTUDIANTE, que es el único rol sin `espacioId` propio. No contradice la
  // decisión del 02/09/2026 —el estudiante sigue siendo una cuenta única,
  // compartida entre espacios, y puede inscribirse en cursos de cualquiera—:
  // dice dónde nació la cuenta, no a quién pertenece. Hacía falta porque
  // "pertenecer a un espacio" se deducía de las inscripciones, y un
  // estudiante recién creado no tiene ninguna, así que desaparecía de la
  // lista de su propio Tutor y obligaba al selector de "Inscribir
  // estudiantes" a mostrar la plataforma entera. Ver `lib/espacio-scope.ts`.
  espacioOrigenId String?
  createdAt DateTime      @default(now())

  // `espacioOrigenId` no lleva relación a propósito (ver el comentario del
  // campo): una segunda relación entre Users y Espacios obligaría a nombrar
  // también esta, y nadie consulta los estudiantes desde el lado del espacio.
  espacio          Espacios?      @relation(fields: [espacioId], references: [id])
  cursosComoTutor  Courses[]      @relation("TutorCourses")
  inscripciones    CourseUsers[]
  contenidosVistos ContentViews[]
  entregas         Entregas[]
  intentosQuiz     IntentosQuiz[]
  rutasComoTutor   Rutas[]        @relation("TutorRutas")
  rutasInscritas   RutaUsuarios[]

  @@map("users")
}

// Épica Multi-docente (Backlog.md, Sprint 7): un espacio = un docente o
// institución. Administradores y Tutores pertenecen a exactamente un
// espacio (Users.espacioId); los cursos lo heredan de su Tutor. Ver
// Diagrama_de_Arquitectura.md, sección "Cambios previstos".
model Espacios {
  id        String        @id @default(uuid())
  nombre    String
  estado    EstadoUsuario @default(ACTIVO)
  createdAt DateTime      @default(now())

  usuarios Users[]

  @@map("espacios")
}

model Courses {
  id          String      @id @default(uuid())
  titulo      String
  descripcion String
  imagen      String?
  tutorId     String
  estado      EstadoCurso @default(BORRADOR)
  createdAt   DateTime    @default(now())
  // US47 (23/11/2026): otro Tutor puede tomar este curso y quedarse con su
  // propia copia. Nace en `false` a propósito — nada se comparte sin que su
  // autor lo diga.
  compartible Boolean     @default(false)
  // De qué curso salió esta copia, si salió de alguno. Se guarda el id para
  // poder contar adopciones, y **el nombre del autor como texto** en vez de
  // una relación: así el crédito sobrevive aunque el curso original se
  // borre o su autor deje la plataforma, que es justo cuando una clave
  // foránea obligaría a elegir entre perder el crédito o impedir el
  // borrado.
  origenCursoId String?
  origenAutor   String?
  // US49 (24/11/2026): el sello de la plataforma. Solo lo otorga el Super
  // Administrador, y no condiciona que el curso se publique: un curso
  // compartido circula igual sin él, solo que sin el respaldo.
  verificado  Boolean     @default(false)

  tutor       Users         @relation("TutorCourses", fields: [tutorId], references: [id])
  inscritos   CourseUsers[]
  contenidos  Contents[]
  secciones   Secciones[]
  actividades Actividades[]
  quizzes     Quizzes[]
  rutas       RutaCursos[]

  @@map("courses")
}

// US44 — Rutas de aprendizaje (20/11/2026).
//
// Es la pieza que la descripción del proyecto pedía desde el principio y
// que todavía no existía: "los alumnos podrán ingresar a un rol de
// estudiante en donde podrán asociarse a unas rutas de aprendizaje tipo
// LMS". Una ruta es una secuencia ordenada de cursos del mismo Tutor — por
// ejemplo "Tecnología 7°: de la informática básica a la robótica" — que el
// estudiante recorre de principio a fin viendo un solo porcentaje de
// avance para todo el camino.
//
// Decisiones:
// - Tabla intermedia propia (`RutaCursos`) en vez de un `rutaId` en
//   `Courses`: un mismo curso puede servir en más de una ruta (un curso de
//   fundamentos aparece tanto en la ruta de programación como en la de
//   robótica), y el `orden` pertenece a la relación, no al curso.
// - Asociarse a una ruta inscribe al estudiante en los cursos publicados
//   de esa ruta (`CourseUsers`), en vez de inventar una segunda forma de
//   dar acceso: así TODO el control de acceso ya escrito (US11, US30, las
//   actividades, los quizzes) sigue valiendo sin cambiarle una línea. Ver
//   `lib/actions/join-ruta.ts`.
// - La ruta la arma un Tutor y le pertenece, igual que un curso.
model Rutas {
  id          String     @id @default(uuid())
  titulo      String
  descripcion String
  imagen      String?
  tutorId     String
  estado      EstadoRuta @default(BORRADOR)
  createdAt   DateTime   @default(now())

  tutor     Users          @relation("TutorRutas", fields: [tutorId], references: [id])
  cursos    RutaCursos[]
  inscritos RutaUsuarios[]

  @@map("rutas")
}

// Un curso dentro de una ruta, con su posición en el camino. `orden` se
// maneja igual que en `Secciones`/`Contents`: incremental al agregar, y el
// Tutor lo reacomoda después.
model RutaCursos {
  id       String @id @default(uuid())
  rutaId   String
  courseId String
  orden    Int    @default(0)

  ruta   Rutas   @relation(fields: [rutaId], references: [id])
  course Courses @relation(fields: [courseId], references: [id])

  @@unique([rutaId, courseId])
  @@map("ruta_cursos")
}

// El estudiante asociado a una ruta. Equivale a `CourseUsers` pero a nivel
// de ruta, y conviven: la inscripción al curso es la que da acceso al
// contenido; esta registra que el estudiante va recorriendo la ruta
// completa, para poder mostrarle el avance del camino y no solo de cada
// curso por separado.
model RutaUsuarios {
  id     String   @id @default(uuid())
  rutaId String
  userId String
  fecha  DateTime @default(now())

  ruta Rutas @relation(fields: [rutaId], references: [id])
  user Users @relation(fields: [userId], references: [id])

  @@unique([rutaId, userId])
  @@map("ruta_usuarios")
}

// US30: agrupa el contenido de un curso en secciones plegables con estado
// (Disponible/No disponible) y una marca opcional de "semana actual", según
// lo acordado con el docente (08/09/2026):
// - Entidad nueva en vez de reutilizar campos existentes, para no forzar un
//   concepto de "semana" sobre cursos que no lo necesitan.
// - `estado` lo fija el Tutor a mano (mismo patrón que Contents.visible en
//   US12), no se calcula por fecha.
// - `esActual` es exclusiva por curso (una sola sección "semana actual" a la
//   vez) — la exclusividad se aplica en `lib/actions/mark-current-section.ts`,
//   no con una restricción de base de datos, porque Postgres no tiene una
//   forma simple de expresar "a lo sumo una fila en TRUE por courseId" sin un
//   índice parcial adicional que no aporta valor para este volumen de datos.
// - El contenido de los cursos ya existentes queda sin sección
//   (`Contents.seccionId` es opcional) y sigue viéndose igual que hoy: lista
//   plana, siempre visible, sin agrupar.
model Secciones {
  id        String        @id @default(uuid())
  courseId  String
  titulo    String
  orden     Int           @default(0)
  estado    EstadoSeccion @default(DISPONIBLE)
  esActual  Boolean       @default(false)
  createdAt DateTime      @default(now())

  course      Courses       @relation(fields: [courseId], references: [id])
  contenidos  Contents[]
  actividades Actividades[]
  quizzes     Quizzes[]

  @@map("secciones")
}

// Evaluaciones de opción múltiple con calificación automática
// (19/11/2026). Son la contraparte rápida de `Actividades`: aquí el
// estudiante no entrega nada que el docente deba leer, el sistema corrige
// solo y devuelve el resultado al instante.
model Quizzes {
  id          String   @id @default(uuid())
  courseId    String
  seccionId   String?
  titulo      String
  descripcion String?
  visible     Boolean  @default(true)
  orden       Int      @default(0)
  // OP08 (21/11/2026): límite de intentos por estudiante, pedido por el
  // docente al probar la evaluación. `null` significa sin límite, que es
  // como se comportaban todas las evaluaciones hasta hoy — así las ya
  // creadas no cambian de reglas a mitad de curso.
  intentosMaximos Int?
  createdAt   DateTime @default(now())

  course    Courses         @relation(fields: [courseId], references: [id])
  seccion   Secciones?      @relation(fields: [seccionId], references: [id])
  preguntas PreguntasQuiz[]
  intentos  IntentosQuiz[]

  @@map("quizzes")
}

model PreguntasQuiz {
  id        String @id @default(uuid())
  quizId    String
  enunciado String
  orden     Int    @default(0)

  quiz     Quizzes        @relation(fields: [quizId], references: [id])
  opciones OpcionesQuiz[]

  @@map("preguntas_quiz")
}

// `esCorrecta` nunca debe viajar al navegador del estudiante: las páginas
// del estudiante seleccionan solo id y texto. Dejarlo salir en el HTML
// equivaldría a publicar la hoja de respuestas.
model OpcionesQuiz {
  id         String  @id @default(uuid())
  preguntaId String
  texto      String
  esCorrecta Boolean @default(false)
  orden      Int     @default(0)

  pregunta PreguntasQuiz @relation(fields: [preguntaId], references: [id])

  @@map("opciones_quiz")
}

// Un registro por intento: se conservan todos (no se sobrescribe el
// anterior como en `Entregas`) porque en un quiz repetir es parte del
// aprendizaje, y el docente quiere ver la evolución, no solo el último
// resultado. `respuestas` guarda el mapa { preguntaId: opcionId } elegido,
// en JSON, para poder mostrarle al estudiante en qué se equivocó sin
// necesitar una quinta tabla.
model IntentosQuiz {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  respuestas  Json
  correctas   Int
  total       Int
  puntaje     Float
  realizadoEn DateTime @default(now())

  quiz Quizzes @relation(fields: [quizId], references: [id])
  user Users   @relation(fields: [userId], references: [id])

  @@map("intentos_quiz")
}

// Actividades evaluables de un curso (19/11/2026). Hasta ahora la
// plataforma solo entregaba contenido y registraba quién lo vio
// (`ContentViews`): el estudiante no tenía nada que presentar y el docente
// nada que calificar, que es justo la mitad del ciclo que describe el
// proyecto ("el docente podrá ver los avances y actividades presentadas por
// los diferentes estudiantes así como las notas obtenidas").
//
// Decisiones:
// - Entidad propia y no un `TipoContenido` más: una actividad tiene cosas
//   que un contenido no tiene (puntaje, fecha límite, entregas), y
//   mezclarlas obligaría a llenar `Contents.contenido` con algo artificial.
// - `seccionId` opcional, igual que en `Contents` (US30): una actividad
//   puede colgar de una sección o quedar suelta en el curso.
// - `visible`, mismo patrón que `Contents.visible` (US12), para prepararla
//   antes de mostrarla.
model Actividades {
  id            String    @id @default(uuid())
  courseId      String
  seccionId     String?
  titulo        String
  descripcion   String?
  // Instrucciones en Markdown, igual que el contenido de tipo TEXTO (US10):
  // se renderizan con `MarkdownContent`, no con HTML crudo.
  instrucciones String
  puntajeMaximo Int       @default(100)
  fechaLimite   DateTime?
  visible       Boolean   @default(true)
  orden         Int       @default(0)
  createdAt     DateTime  @default(now())

  course   Courses    @relation(fields: [courseId], references: [id])
  seccion  Secciones? @relation(fields: [seccionId], references: [id])
  entregas Entregas[]

  @@map("actividades")
}

// Lo que un estudiante presenta para una actividad, y la nota que le pone
// el tutor. Una sola entrega por estudiante y actividad (`@@unique`): si
// vuelve a entregar, se reemplaza la anterior en vez de acumular intentos
// — decisión para esta primera versión, más simple de calificar.
model Entregas {
  id String @id @default(uuid())

  actividadId String
  userId      String

  // El estudiante puede responder escribiendo, adjuntando un archivo, o
  // ambas cosas; la Server Action exige al menos una de las dos.
  texto         String?
  archivo       String?
  nombreArchivo String?
  entregadaEn   DateTime @default(now())

  // Calificación: `nota` en null significa "entregada, sin calificar".
  nota              Float?
  retroalimentacion String?
  calificadaEn      DateTime?

  actividad Actividades @relation(fields: [actividadId], references: [id])
  user      Users       @relation(fields: [userId], references: [id])

  @@unique([actividadId, userId])
  @@map("entregas")
}

model CourseUsers {
  id       String   @id @default(uuid())
  courseId String
  userId   String
  fecha    DateTime @default(now())

  course Courses @relation(fields: [courseId], references: [id])
  user   Users   @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
  @@map("course_users")
}

model Contents {
  id          String        @id @default(uuid())
  courseId    String
  titulo      String
  descripcion String?
  tipo        TipoContenido
  contenido   String
  orden       Int           @default(0)
  visible     Boolean       @default(true)
  // US30: sección a la que pertenece este contenido, opcional (ver
  // `Secciones` arriba) — sin sección asignada, el contenido se comporta
  // exactamente igual que antes de US30 (lista plana, siempre visible).
  seccionId   String?
  // 22/11/2026: era la única tabla de contenido del curso sin fecha de
  // creación, y sin ella no hay forma de saber qué lección es nueva para el
  // bloque de novedades del Estudiante.
  createdAt   DateTime      @default(now())

  course     Courses        @relation(fields: [courseId], references: [id])
  seccion    Secciones?     @relation(fields: [seccionId], references: [id])
  documentos Documents[]
  vistos     ContentViews[]

  @@map("contents")
}

model Documents {
  id        String @id @default(uuid())
  contentId String
  archivo   String
  nombre    String
  tipo      String

  content Contents @relation(fields: [contentId], references: [id])

  @@map("documents")
}

// US19: registra que un Estudiante vio un contenido, para calcular el
// porcentaje de avance por curso en su dashboard. Se marca cuando el
// Estudiante hace clic en "Marcar como visto" sobre ese contenido — ver
// `lib/actions/mark-content-viewed.ts` (rediseñado el 2026-08-31; el
// diseño original la marcaba automáticamente al abrir la página, pero
// eso no distinguía "abrió la página" de "consumió el contenido").
// La restricción única evita duplicados si se marca más de una vez, y
// conserva la fecha de la primera vez que se vio.
model ContentViews {
  id        String   @id @default(uuid())
  contentId String
  userId    String
  vistoEn   DateTime @default(now())

  content Contents @relation(fields: [contentId], references: [id])
  user    Users    @relation(fields: [userId], references: [id])

  @@unique([contentId, userId])
  @@map("content_views")
}
